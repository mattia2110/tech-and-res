entity = {
	name = "ztr_eu_ship_container_01_entity"
	pdxmesh = "ztr_eu_ship_container_01_mesh"
	cull_radius = 10

	default_state = "moving"
	state = {
		name = "moving"
		animation = "moving_animation"
		looping = yes
		event = { time = 0 node = "ztr_chimney_01" particle = "infrastructure/ship_chimney" trigger_once = yes }
		start_event = { sound = { soundeffect = "event:/SFX/Vehicles/ships/ship_cargo" } keep_sound = yes }
	}
}
