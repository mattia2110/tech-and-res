		index = 0
		texture_diffuse = "ztr_eu_ship_container_diffuse.dds"
		texture_normal = "ztr_eu_ship_container_normal.dds"
		texture_specular = "ztr_eu_ship_container_properties.dds"
		shader = "standard"
		additional_shader_defines = { "EMISSIVE_NIGHT" }
		shader_file = "gfx/FX/pdxmesh.shader"
	}

	meshsettings = {
		name = "ztr_eu_ship_container_01_LOD2"
		index = 0
		texture_diffuse = "ztr_eu_ship_container_diffuse.dds"
		texture_normal = "ztr_eu_ship_container_normal.dds"
		texture_specular = "ztr_eu_ship_container_properties.dds"
